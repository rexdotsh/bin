{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bin",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",

  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "next.bin.rex.wf", "custom_domain": true }],

  "build": { "command": "bun run build" },
  "assets": { "directory": "./dist", "binding": "ASSETS" },

  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "bin" }],

  "ratelimits": [{ "name": "ANON", "namespace_id": "2001", "simple": { "limit": 20, "period": 60 } }],

  "durable_objects": { "bindings": [{ "name": "LIVE", "class_name": "Live" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Live"] }]
}
