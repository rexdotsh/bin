{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bin",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",

  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "bin.rex.wf", "custom_domain": true }],

  "build": { "command": "bun run build" },
  "rules": [{ "type": "Text", "globs": ["**/*.css"], "fallthrough": true }],
  "assets": { "directory": "./dist", "binding": "ASSETS" },

  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "bin" }],

  "ratelimits": [
    { "name": "ANON", "namespace_id": "2001", "simple": { "limit": 20, "period": 60 } },
    { "name": "ANON_BYTES", "namespace_id": "2002", "simple": { "limit": 40, "period": 60 } }
  ],

  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Live"] },
    { "tag": "v2", "deleted_classes": ["Live"] }
  ]
}
